    {
      "alt_summary": "Comparison of fragile and controlled calculations.",
      "artifact_type": "compare",
      "audio_reference": "audio/calculation-example/slide-01.mp3",
      "cta_destination": "",
      "cta_type": "",
      "duration_ms": 14480,
      "evidence_source": "",
      "evidence_type": "none",
      "eyebrow": "The trust problem",
      "headline": "The arithmetic is usually easy. Trusting the inputs and definitions is harder.",
      "id": "slide-01",
      "index": 1,
      "narration_audio_reference": "audio/calculation-example/slide-01.mp3",
      "narration_certification_ready": true,
      "narration_duration_seconds": 13.68,
      "narration_output_sha256": "f274222fe778078fed4b54660265e29782435d5a70de7d0e81aa931bb102d665",
      "narration_script": "Arithmetic is usually easy. Trust fails when periods, units, definitions, assumptions, or sources are unclear. A controlled model stores inputs once, states rules, and keeps checks and unresolved review visible.",
      "narration_transcript": "Arithmetic is usually easy. Trust fails when periods, units, definitions, assumptions, or sources are unclear. A controlled model stores inputs once, states rules, and keeps checks and unresolved review visible.",
      "point_count": 3,
      "points": [
        "Separate typed source values from calculated outputs.",
        "State units, periods, definitions, and assumptions beside the model.",
        "Make failures and unresolved review steps visible."
      ],
      "role": "title",
      "seconds": 14.48,
      "subhead": "A correct formula can still produce the wrong decision when periods, units, definitions, assumptions, or source values are unclear."
    },
